GIT_AUTHOR_EMAIL="iman.suherman@gmail.com" \
GIT_COMMITTER_NAME="Iman Suherman" \
GIT_COMMITTER_EMAIL="iman.suherman@gmail.com" \
git commit -m "$(cat <<'EOF'
Commit message here.

EOF
)"
```
