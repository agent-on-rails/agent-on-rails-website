---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agent On Rails',
  description = 'From specs to running software. Define the contract. Let agents deliver it — with review, escalation, and evidence before done.',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1F3A" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/favicon.png?v=2b19b6f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/brand/logo-mark.png?v=2b19b6f', Astro.site || 'https://agent-on-rails.suherman.net').href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class="bg-atmosphere min-h-screen antialiased">
    <slot />
  </body>
</html>
