---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found · Agent On Rails">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-20">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink">Track ends here.</h1>
    <p class="mt-4 text-ink-mute">That page is not on the rails.</p>
    <a href="/" class="mt-8 inline-flex w-fit rounded-md bg-ink px-5 py-3 text-sm font-semibold text-white">Back home</a>
  </main>
</BaseLayout>
