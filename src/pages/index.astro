---
import BaseLayout from '../layouts/BaseLayout.astro';
import { setupRelease } from '../lib/setup-release';

const cli = 'https://github.com/agent-on-rails/agent-on-rails-cli';
const desktop = 'https://github.com/agent-on-rails/agent-on-rails-desktop';
const release = setupRelease();
---

<BaseLayout>
  <div class="relative overflow-hidden">
    <div class="rail-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <header class="relative z-20 mx-auto flex max-w-6xl items-center justify-between px-6 py-5 md:px-8">
      <a href="/" class="inline-flex items-center gap-3" aria-label="Agent On Rails home">
        <img src="/brand/logo-mark.png?v=2b19b6f" alt="" width="40" height="40" class="h-10 w-10 object-contain" />
        <span class="font-display text-lg font-bold tracking-tight text-ink">
          Agent <span class="text-rail">On</span> Rails
        </span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium text-ink-soft md:flex">
        <a href="#how" class="transition hover:text-ink">How it works</a>
        <a href="#principle" class="transition hover:text-ink">Principle</a>
        <a href="#team" class="transition hover:text-ink">AI Team</a>
        <a href="/docs" class="transition hover:text-ink">Docs</a>
        <a href="/docs#setup" class="transition hover:text-ink">Setup</a>
        <a href={cli} class="transition hover:text-ink" target="_blank" rel="noreferrer">CLI</a>
      </nav>
    </header>

    <!-- Hero: one composition — brand, headline, sentence, CTAs, dominant visual -->
    <section class="relative z-10 mx-auto grid min-h-[calc(100svh-5rem)] max-w-6xl items-center gap-10 px-6 pb-16 pt-6 md:grid-cols-12 md:gap-8 md:px-8 md:pb-24 md:pt-4">
      <div class="md:col-span-6 lg:col-span-5">
        <p class="animate-rise-in font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Agent <span class="text-rail">On</span> Rails
        </p>
        <h1 class="animate-rise-in delay-1 mt-6 max-w-xl font-display text-2xl font-semibold leading-snug text-ink-soft sm:text-3xl">
          From specs to running software.
        </h1>
        <p class="animate-rise-in delay-2 mt-5 max-w-md text-base leading-relaxed text-ink-mute sm:text-lg">
          Define the contract. Let agents deliver it — with review, escalation, and evidence before done.
        </p>
        <div class="animate-rise-in delay-3 mt-8 flex flex-col gap-4">
          <a
            href="/docs"
            class="inline-flex w-fit items-center justify-center rounded-md bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:bg-ink-soft"
          >
            How to use Agent On Rails
          </a>
          {
            release.version && (
              <p class="text-sm text-ink-soft">
                <span class="font-semibold text-ink">Setup {release.version}</span>
                {release.released && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <time datetime={release.isoDate}>{release.released}</time>
                  </>
                )}
              </p>
            )
          }
          <div class="flex flex-wrap items-center gap-2.5" role="group" aria-label="Download setup app">
            <a
              href="/downloads/Agent-On-Rails-Setup-macos.dmg"
              class="inline-flex items-center gap-2 rounded-md border border-ink/15 bg-white/70 px-4 py-2.5 text-sm font-semibold text-ink transition hover:border-rail hover:text-rail-deep"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.13 2.05c-.95.1-2.1.68-2.76 1.48-.6.72-1.12 1.8-.92 2.84 1.04.04 2.12-.6 2.76-1.4.62-.76 1.08-1.84.92-2.92zM20.4 17.2c-.56 1.28-.82 1.84-1.54 2.96-.98 1.52-2.36 3.4-4.08 3.42-1.52.02-1.92-.98-4-1-.2.04-2.06.16-3.52 1.12C5.7 24.8 4.4 23.3 3.2 21.4 1.1 17.9.04 12.7 2.4 9.2c1.2-1.8 3.1-2.9 4.9-2.9 1.82-.04 3.34 1.2 4.5 1.2 1.12 0 2.88-1.48 4.86-1.26.84.04 3.18.34 4.68 2.54-4.12 2.24-3.44 8.08-.94 8.42z" />
              </svg>
              macOS
            </a>
            <a
              href="/downloads/Agent-On-Rails-Setup-windows.msi"
              class="inline-flex items-center gap-2 rounded-md border border-ink/15 bg-white/70 px-4 py-2.5 text-sm font-semibold text-ink transition hover:border-rail hover:text-rail-deep"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 5.1 10.4 4.1v7.1H3V5.1zm0 13.8 7.4 1V12.9H3v6zm8.2 1.2L21 21.5V12.9h-9.8v7.2zM11.2 4 21 2.5v9.7h-9.8V4z" />
              </svg>
              Windows
            </a>
            <a
              href="/docs#setup-linux"
              class="inline-flex items-center gap-2 rounded-md border border-ink/15 bg-white/70 px-4 py-2.5 text-sm font-semibold text-ink transition hover:border-rail hover:text-rail-deep"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.2 2c-1.7 0-2.9 1.5-2.5 3.1.2.7.3 1.2.3 1.8 0 .8-.3 1.6-.9 2.3-.9 1.3-1.6 2.8-1.6 4.4 0 .8.3 1.5.9 1.9-.1.5-.2.9-.2 1.4 0 1.9 1.3 3.5 3.1 4.1.4 1.5 1.7 2.6 3.3 2.6s2.9-1.1 3.3-2.6c1.8-.6 3.1-2.2 3.1-4.1 0-.5-.1-.9-.2-1.4.6-.4.9-1.1.9-1.9 0-1.6-.7-3.1-1.6-4.4-.6-.7-.9-1.5-.9-2.3 0-.6.1-1.1.3-1.8.4-1.6-.8-3.1-2.5-3.1h-1.8zm-1.5 14.8c-.4 0-.8.3-.8.8s.4.8.8.8.8-.3.8-.8-.4-.8-.8-.8zm3.6 0c-.4 0-.8.3-.8.8s.4.8.8.8.8-.3.8-.8-.4-.8-.8-.8z" />
              </svg>
              Linux
            </a>
          </div>
          <p class="text-xs text-ink-mute">
            Setup app for macOS (drag into Applications) &amp; Windows · Linux from source
          </p>
        </div>
      </div>

      <div class="relative md:col-span-6 lg:col-span-7">
        <div class="animate-rise-in delay-2 relative mx-auto max-w-lg md:max-w-none">
          <div class="absolute -inset-8 -z-10 rounded-[40%] bg-gradient-to-br from-rail/25 via-transparent to-rail-deep/10 blur-2xl" aria-hidden="true"></div>
          <img
            src="/brand/logo-mark.png?v=2b19b6f"
            alt="Agent On Rails mark — a friendly agent on converging rails"
            width="720"
            height="720"
            class="animate-soft-float mx-auto w-full max-w-[28rem] object-contain drop-shadow-rail md:max-w-[34rem]"
          />
          <svg class="pointer-events-none absolute inset-x-8 bottom-6 hidden h-24 w-auto text-rail md:block" viewBox="0 0 400 80" fill="none" aria-hidden="true">
            <path class="animate-track-draw" d="M20 60 L200 20 L380 60" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="240" />
            <path class="animate-track-draw delay-1" d="M40 68 L200 32 L360 68" stroke="currentColor" stroke-width="2" opacity="0.45" stroke-linecap="round" stroke-dasharray="240" />
          </svg>
        </div>
      </div>
    </section>
  </div>

  <section id="how" class="relative border-t border-ink/8 bg-white/60">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">How it works</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Docs define intent. Specs define the contract.
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-ink-mute">
        Agent On Rails does not start by running an agent. It starts by making the product contract real — then governing execution until evidence proves completion.
      </p>

      <ol class="mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
        {
          [
            { n: '01', t: 'Authority', d: 'Product docs, ADRs, policies, and specs live in the control plane.' },
            { n: '02', t: 'Plan', d: 'Approved specs become a task graph — not one unbounded prompt.' },
            { n: '03', t: 'Execute', d: 'An AI Team implements on Git — branches, PRs, and Checks — with cheap-first routing and forever-loop detection.' },
            { n: '04', t: 'Prove', d: 'Independent review + evidence + run report, then human final review before merge.' },
          ].map((step) => (
            <li class="relative border-l-2 border-rail/50 pl-5 md:border-l-0 md:border-t-2 md:pl-0 md:pt-5">
              <span class="font-display text-sm font-bold text-rail-deep">{step.n}</span>
              <h3 class="mt-2 font-display text-xl font-bold text-ink">{step.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-mute">{step.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="principle" class="relative border-t border-ink/8 bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Core principle</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-bold tracking-tight text-ink md:text-5xl">
        GitHub is the operating surface.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-mute md:text-xl">
        Agent On Rails does not invent a parallel console for MVP. Agents work where your team already ships:
        Issues for visibility, labels for state, pull requests for delivery, Checks for verification —
        then humans own final review and merge.
      </p>
      <ul class="mt-12 grid gap-8 border-t border-ink/10 pt-10 sm:grid-cols-3">
        {
          [
            { t: 'Issues & labels', d: 'Spec and task state stays visible with aor:* labels — no hidden agent chat.' },
            { t: 'Branches & PRs', d: 'Implementors open pull requests against the contract; diffs are the unit of work.' },
            { t: 'Checks & merge', d: 'Evidence lands on the PR; humans approve the gate before anything reaches main.' },
          ].map((item) => (
            <li>
              <h3 class="font-display text-lg font-bold text-ink">{item.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-mute">{item.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="team" class="relative overflow-hidden border-t border-ink/8">
    <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink-soft to-[#0a2a4a]" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 20% 20%, rgba(46,182,255,0.35), transparent 40%), radial-gradient(circle at 80% 80%, rgba(46,182,255,0.2), transparent 45%);" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail">AI Team</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight text-white md:text-4xl">
        Not a lone agent. A governed team.
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-white/70">
        Define Manager, Implementor, and Reviewer roles — then let Agent On Rails operate the team until the contract is satisfied.
      </p>

      <ul class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          [
            { t: 'Manager', d: 'Orchestrates hops, classifies failures, escalates or stops stuck paths, and emits the run report.' },
            { t: 'Implementor', d: 'Writes and fixes code against the bounded task contract.' },
            { t: 'Reviewer', d: 'Judges diffs against acceptance and evidence — never self-approves.' },
          ].map((role) => (
            <li class="border-t border-white/20 pt-5">
              <h3 class="font-display text-xl font-bold text-white">{role.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{role.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-ink/8 bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Why it exists</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Built for delivery control — not another chat IDE.
      </h2>
      <div class="mt-12 grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          [
            { t: 'Specs as authority', d: 'Approved specifications bind planners, agents, and reviewers.' },
            { t: 'Evidence before done', d: 'Completion requires PRs, tests, review, and an audit trail.' },
            { t: 'Cheap-first escalation', d: 'Start inexpensive. Same stuck failure climbs tiers then human; different bugs are normal progress.' },
            { t: 'Watchdog, not babysitting', d: 'Hung builds, npm, or devices fail fast, notify, and continue independent work — with a run report at wave end.' },
            { t: 'Human final review', d: 'Agents prepare the change; people own the merge gate.' },
          ].map((item) => (
            <div class="border-t border-ink/10 pt-5">
              <h3 class="font-display text-lg font-bold text-ink">{item.t}</h3>
              <p class="mt-2 text-ink-mute">{item.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-ink/8 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24">
      <div class="max-w-3xl">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Dogfood</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Proven on real products.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-mute">
          Agent On Rails is being built using Agent On Rails. The first external proving ground is
          <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="https://lakuyo.suherman.net" target="_blank" rel="noreferrer">Lakuyo</a>
          — a multi-repo POS delivery system already running on control-plane discipline.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-ink/8">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-rail-wash via-white to-paper px-8 py-14 md:px-14">
        <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-rail/20 blur-3xl" aria-hidden="true"></div>
        <h2 class="relative font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
          Start with Agent On Rails.
        </h2>
        <p class="relative mt-4 max-w-xl text-lg text-ink-mute">
          Use the setup app or CLI, write a spec, approve it, and hand a bounded task to a coding agent.
          The contract folder is the source of truth — agents implement, evidence proves done.
        </p>
        {
          release.version && (
            <p class="relative mt-5 text-sm text-ink-soft">
              <span class="font-semibold text-ink">Setup {release.version}</span>
              {release.released && (
                <>
                  <span aria-hidden="true"> · </span>
                  <time datetime={release.isoDate}>{release.released}</time>
                </>
              )}
            </p>
          )
        }
        <div class="relative mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/docs"
            class="inline-flex items-center justify-center rounded-md bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:bg-ink-soft"
          >
            How to use Agent On Rails
          </a>
          <a
            href="/downloads/Agent-On-Rails-Setup-macos.dmg"
            class="inline-flex items-center justify-center rounded-md border border-ink/15 bg-white/80 px-5 py-3 text-sm font-semibold text-ink transition hover:border-rail hover:text-rail-deep"
          >
            Download for macOS
          </a>
          <a
            href={desktop}
            class="inline-flex items-center justify-center rounded-md border border-ink/15 bg-white/80 px-5 py-3 text-sm font-semibold text-ink transition hover:border-rail hover:text-rail-deep"
            target="_blank"
            rel="noreferrer"
          >
            Setup app on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer class="border-t border-ink/10 bg-ink text-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <img src="/brand/logo-mark.png?v=2b19b6f" alt="" width="32" height="32" class="h-8 w-8 object-contain" />
        <div>
          <p class="font-display font-bold">Agent <span class="text-rail">On</span> Rails</p>
          <p class="text-sm text-white/55">A product by <a class="underline-offset-2 hover:underline" href="https://suherman.net">suherman.net</a></p>
        </div>
      </div>
      <p class="text-sm text-white/45">© {new Date().getFullYear()} Agent On Rails</p>
    </div>
  </footer>
</BaseLayout>
