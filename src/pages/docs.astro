---
import BaseLayout from '../layouts/BaseLayout.astro';

const cli = 'https://github.com/agent-on-rails/agent-on-rails-cli';
const desktop = 'https://github.com/agent-on-rails/agent-on-rails-desktop';
const gettingStarted = `${cli}/blob/main/docs/getting-started.md`;
const walkthrough = `${cli}/blob/main/docs/walkthrough.md`;
const linuxServer = `${cli}/blob/main/docs/linux-server.md`;
const whatToSetup = `${cli}/blob/main/docs/what-to-setup.md`;
const controlPlane = 'https://github.com/agent-on-rails/agent-on-rails-control-plane';
const howToUse = `${controlPlane}/blob/main/guides/using-the-control-plane.md`;
const agentsMd = `${controlPlane}/blob/main/AGENTS.md`;
const specs = `${controlPlane}/tree/main/specs`;
const aor006 = `${controlPlane}/blob/main/specs/AOR-006-model-escalation/spec.md`;
const aor009 = `${controlPlane}/blob/main/specs/AOR-009-unattended-ai-team-runtime/spec.md`;
const escalation = `${controlPlane}/blob/main/policies/escalation.md`;
const watchdog = `${controlPlane}/blob/main/policies/execution-watchdog.md`;
const phase1 = `${controlPlane}/blob/main/plans/phase-1-backend-coherence.md`;
const adr008 = `${controlPlane}/blob/main/adr/ADR-008-desktop-setup-wizard.md`;
---

<BaseLayout
  title="How to use Agent On Rails"
  description="Install Agent On Rails via the macOS/Windows setup app or CLI, write a spec, approve it, and hand a bounded task to a coding agent — with review and evidence before done."
>
  <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5 md:px-8">
    <a href="/" class="inline-flex items-center gap-3" aria-label="Agent On Rails home">
      <img src="/brand/logo-mark.png?v=2b19b6f" alt="" width="36" height="36" class="h-9 w-9 object-contain" />
      <span class="font-display text-lg font-bold tracking-tight text-ink">
        Agent <span class="text-rail">On</span> Rails
      </span>
    </a>
    <a href="/" class="text-sm font-medium text-ink-mute hover:text-ink">Home</a>
  </header>

  <main class="mx-auto max-w-3xl px-6 pb-24 pt-8 md:px-8">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Documentation</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink">
      How to use Agent On Rails
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-mute">
      Agent On Rails turns an approved spec into bounded work for coding agents —
      with review and evidence before anything is marked done.
      The <strong class="font-semibold text-ink">control plane</strong> is the contract folder
      inside your project, not the product name.
    </p>

    <section id="checklist" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">What you need to set up</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Already have <code class="text-ink">aor</code>? You mainly need a project contract, a coding agent, and a human approver.
        Agent On Rails does not replace Cursor / Claude / Codex — it packages the work for them.
      </p>
      <ol class="mt-6 space-y-3 text-ink-mute">
        <li><span class="font-semibold text-ink">1. Python 3.11+ + git + <code class="text-ink">aor</code></span> — if <code class="text-ink">aor guide</code> works, CLI is done.</li>
        <li><span class="font-semibold text-ink">2. Project contract</span> — <code class="text-ink">aor init ./my-product --name "My Product"</code> (docs+specs only).</li>
        <li><span class="font-semibold text-ink">3. Coding agent</span> — Cursor, Claude Code, Codex, Gemini, or your Teknopus agent runner.</li>
        <li><span class="font-semibold text-ink">4. Human gates</span> — approve specs and final-review; evidence before done.</li>
        <li><span class="font-semibold text-ink">Optional</span> — <code class="text-ink">aor team</code>, GitHub <code class="text-ink">gh</code>, API keys on the coding agent (not in git).</li>
      </ol>
      <p class="mt-4">
        <a
          class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail"
          href={whatToSetup}
          target="_blank"
          rel="noreferrer"
        >
          Full setup checklist on GitHub →
        </a>
      </p>
    </section>

    <section id="setup" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Setup app (macOS, Windows, Linux)</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Prefer a wizard? The desktop setup app checks Python, installs the
        <code class="text-ink">aor</code> CLI, and bootstraps your first docs+specs project —
        then hands off to the terminal UI. Onboarding only
        (<a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={adr008} target="_blank" rel="noreferrer">ADR-008</a>);
        day-to-day work stays in <code class="text-ink">aor</code>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/downloads/Agent-On-Rails-Setup-macos.dmg"
          class="inline-flex items-center justify-center rounded-md bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:bg-ink-soft"
        >
          Download for macOS (.dmg)
        </a>
        <a
          href="/downloads/Agent-On-Rails-Setup-windows.msi"
          class="inline-flex items-center justify-center rounded-md border border-ink/20 bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:border-ink/40"
        >
          Download for Windows (.msi)
        </a>
        <a
          href="#setup-linux"
          class="inline-flex items-center justify-center rounded-md border border-ink/20 bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:border-ink/40"
        >
          Linux — build from source
        </a>
      </div>
      <p class="mt-3 text-sm text-ink-mute leading-relaxed">
        macOS builds are signed with Developer ID (Sparkle auto-update via
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="/downloads/appcast.xml">appcast.xml</a>).
        Windows MSI is published from GitHub Actions (unsigned until a code-signing certificate is configured). Requires Python 3.11+.
      </p>

      <div id="setup-linux" class="mt-8 scroll-mt-24 rounded-xl border border-ink/10 bg-white/70 px-5 py-5">
        <h3 class="font-display text-lg font-bold text-ink">Linux — compile yourself</h3>
        <p class="mt-2 text-sm text-ink-mute leading-relaxed">
          No prebuilt Linux installer. Build the Tauri wizard locally (Node 20+, Rust, WebKitGTK),
          or skip the GUI and use the
          <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="#linux">CLI-only Linux path</a> below.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code># Debian/Ubuntu system deps
sudo apt update
sudo apt install -y curl build-essential pkg-config \
  libwebkit2gtk-4.1-dev libayatana-appindicator3-dev \
  librsvg2-dev patchelf libssl-dev

# Build the setup wizard
git clone https://github.com/agent-on-rails/agent-on-rails-desktop.git
cd agent-on-rails-desktop
npm install
npm run tauri build
# → src-tauri/target/release/bundle/</code></pre>
        <p class="mt-3 text-sm text-ink-mute leading-relaxed">
          Full notes:
          <a
            class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail"
            href={`${desktop}/blob/main/docs/build-linux.md`}
            target="_blank"
            rel="noreferrer"
          >
            docs/build-linux.md
          </a>
          · Fedora packages included there.
        </p>
      </div>
    </section>

    <section id="linux" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Linux / server (agent host)</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Lightest path for a Linux laptop or agent machine (Python CLI only — no desktop GUI).
        Same harness as Hermes-style workflows: approve a spec, package a bounded task, let your coding agent implement.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code>sudo apt install -y python3 python3-pip python3-venv git pipx   # Debian/Ubuntu
pipx ensurepath
pipx install git+https://github.com/agent-on-rails/agent-on-rails-cli.git
aor init ./my-product --name "My Product"
cd my-product && aor</code></pre>
      <p class="mt-4">
        <a
          class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail"
          href={linuxServer}
          target="_blank"
          rel="noreferrer"
        >
          Full Linux / server implementation steps →
        </a>
      </p>
    </section>

    <section id="install" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Install the CLI</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Works on macOS, Windows, and Linux. Requires Python 3.11+. Prefer
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="https://pipx.pypa.io/">pipx</a>:
      </p>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code>pipx install git+https://github.com/agent-on-rails/agent-on-rails-cli.git
aor</code></pre>
      <p class="mt-3 text-ink-mute leading-relaxed">
        <code class="text-ink">aor</code> opens a mouse-friendly terminal UI (same idea as OpenCode, Claude Code, or Gemini).
        It is a harness — not a coding agent. Subcommands still work for scripts.
      </p>
      <p class="mt-3 text-sm text-ink-mute">
        Or:
        <code class="rounded bg-ink/5 px-1.5 py-0.5 text-ink">curl -fsSL https://raw.githubusercontent.com/agent-on-rails/agent-on-rails-cli/main/scripts/install.sh | bash</code>
      </p>
    </section>

    <section id="loop" class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ink">The loop</h2>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code>aor init → aor spec new → aor spec approve → aor plan → aor run → aor review</code></pre>
      <ol class="mt-6 space-y-3 text-ink-mute">
        <li><span class="font-semibold text-ink">1. Init</span> — create the docs+specs contract. No application code.</li>
        <li><span class="font-semibold text-ink">2. Spec</span> — write <code class="text-ink">spec.md</code> + acceptance + evidence.</li>
        <li><span class="font-semibold text-ink">3. Approve</span> — a human must approve before agents run.</li>
        <li><span class="font-semibold text-ink">4. Plan / run</span> — Agent On Rails packages a bounded task for Cursor, Claude, Codex, or another headless agent. With the engine online, <code class="text-ink">aor run</code> registers the task and drives implementor ↔ reviewer under policy.</li>
        <li><span class="font-semibold text-ink">5. Review</span> — humans own final review and merge. Evidence proves done.</li>
      </ol>
    </section>

    <section id="governance" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Escalation, watchdog &amp; unattended runtime</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Approved contracts
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={aor006} target="_blank" rel="noreferrer">AOR-006</a>
        and
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={aor009} target="_blank" rel="noreferrer">AOR-009</a>
        define how Agent On Rails decides retries, stops forever-loops, and fails fast on environment hangs —
        without babysitting the terminal.
      </p>
      <ul class="mt-6 space-y-4 text-ink-mute">
        <li>
          <span class="font-semibold text-ink">Intelligent escalation (Option A)</span> —
          distinct bugs across fix↔review are normal progress. The <em>same</em> failure signature climbs
          tier 1 → 2 → 3 → human. Strike max is only a safety ceiling.
        </li>
        <li>
          <span class="font-semibold text-ink">Environment ≠ smarter model</span> —
          hung Gradle, npm, or a missing device is cancelled, notified, and marked
          <code class="text-ink">blocked_environment</code>. Independent work continues.
          Wave-level <code class="text-ink">HUMAN_REQUIRED</code> only when blocking acceptance remains.
        </li>
        <li>
          <span class="font-semibold text-ink">Run report</span> —
          every wave ends with a durable report:
          <code class="text-ink">spec_id</code>, <code class="text-ink">terminal_status</code>,
          completed, blocked environment, skipped deps, coding failures, human actions, notifications.
          The engine authors it; empty lists are allowed, omitted keys are not.
        </li>
        <li>
          <span class="font-semibold text-ink">Task API</span> —
          register with <code class="text-ink">POST /v1/tasks</code>, then run. The engine owns attempt,
          tier, and signature history — callers report events.
        </li>
        <li>
          <span class="font-semibold text-ink">Watchdog classification</span> —
          specific-first: <code class="text-ink">./gradlew test</code> is a test,
          <code class="text-ink">build</code> / <code class="text-ink">assemble*</code> is a build —
          not a short device timeout by default.
        </li>
      </ul>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={escalation} target="_blank" rel="noreferrer">Escalation policy →</a>
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={watchdog} target="_blank" rel="noreferrer">Execution watchdog →</a>
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href={phase1} target="_blank" rel="noreferrer">Phase 1 coherence plan →</a>
      </p>
    </section>

    <section id="walkthrough" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Walkthrough — start to final review</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Full path: install → init → write spec → human approve → plan → run →
        coding agent implements → evidence → human final review.
      </p>
      <ol class="mt-6 space-y-4 text-ink-mute">
        <li>
          <span class="font-semibold text-ink">1. Install &amp; open TUI</span> —
          use the <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="#setup">setup app</a>
          or <code class="text-ink">pipx install …</code>, then <code class="text-ink">aor</code>.
        </li>
        <li>
          <span class="font-semibold text-ink">2. Init</span> —
          create the docs+specs contract (no app code).
        </li>
        <li>
          <span class="font-semibold text-ink">3. New spec</span> —
          edit <code class="text-ink">spec.md</code>, acceptance, and evidence while status is DRAFT.
        </li>
        <li>
          <span class="font-semibold text-ink">4. Approve</span> —
          human gate. Agents cannot skip this.
        </li>
        <li>
          <span class="font-semibold text-ink">5. Plan + Run</span> —
          packages <code class="text-ink">.aor/packages/TASK-00N/prompt.md</code> for Cursor / Claude / Codex.
        </li>
        <li>
          <span class="font-semibold text-ink">6. Implement</span> —
          in the sibling app repo only. PR + tests = evidence.
        </li>
        <li>
          <span class="font-semibold text-ink">7. Final review</span> —
          human Review in the TUI (or <code class="text-ink">aor review TASK-001 --approve</code>). Ready when evidence exists.
        </li>
      </ol>
      <p class="mt-4">
        <a
          class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail"
          href={walkthrough}
          target="_blank"
          rel="noreferrer"
        >
          Open the full walkthrough on GitHub →
        </a>
      </p>
    </section>

    <div class="mt-12 space-y-6 border-t border-ink/10 pt-10">
      <a
        href={whatToSetup}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Setup checklist</h2>
        <p class="mt-2 text-ink-mute">
          What is required vs optional before the first Plan → Run.
        </p>
      </a>

      <a
        href={linuxServer}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Linux / server guide</h2>
        <p class="mt-2 text-ink-mute">
          Lightweight install on an agent host, first loop, and upgrade tips.
        </p>
      </a>

      <a
        href={walkthrough}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Full walkthrough (start → final review)</h2>
        <p class="mt-2 text-ink-mute">
          Screen-by-screen TUI steps, command-line twin, checklist, and stuck? fixes.
        </p>
      </a>

      <a
        href={gettingStarted}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">CLI reference</h2>
        <p class="mt-2 text-ink-mute">
          Install options, loop table, and what <code class="text-ink">aor run</code> does today.
        </p>
      </a>

      <a href={desktop} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">Setup app (macOS / Windows)</h2>
        <p class="mt-2 text-ink-mute">
          Desktop wizard to install <code class="text-ink">aor</code> and run <code class="text-ink">aor init</code>.
        </p>
      </a>

      <a href={cli} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">CLI repository</h2>
        <p class="mt-2 text-ink-mute">Download and develop <code class="text-ink">aor</code> on GitHub.</p>
      </a>

      <a
        href={howToUse}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Authority / contract guide</h2>
        <p class="mt-2 text-ink-mute">
          How specs, ADRs, policies, and evidence work inside the control-plane folder.
        </p>
      </a>

      <a href={agentsMd} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">AGENTS.md</h2>
        <p class="mt-2 text-ink-mute">
          Required first read for any coding agent — boundaries, review separation, and evidence rules.
        </p>
      </a>

      <a href={specs} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">Specs (AOR-001 … AOR-009)</h2>
        <p class="mt-2 text-ink-mute">
          MVP contracts for bootstrap, GitHub, planner, execution, review, escalation, evidence, desktop setup, and unattended AI Team runtime.
        </p>
      </a>

      <a href={aor006} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">AOR-006 — Model escalation</h2>
        <p class="mt-2 text-ink-mute">
          Forever-loop vs normal progress, Option A ladder, and auditable escalation history.
        </p>
      </a>

      <a href={aor009} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">AOR-009 — Unattended AI Team runtime</h2>
        <p class="mt-2 text-ink-mute">
          Manager loop, watchdog, RunReport, task API, and wave-level human gates.
        </p>
      </a>

      <a href={controlPlane} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">Control plane repository</h2>
        <p class="mt-2 text-ink-mute">The authority tree — what should be built and how success is proven.</p>
      </a>
    </div>

    <section class="mt-14 rounded-2xl bg-gradient-to-br from-rail-wash via-white to-paper px-6 py-8">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Core principle</p>
      <h2 class="mt-2 font-display text-2xl font-bold text-ink">GitHub is the operating surface</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Agents ship through Issues, labels, PRs, and Checks — not a parallel console.
        Docs define intent. Specs define the contract. Agent On Rails governs execution.
        Evidence proves completion. Humans own final review and merge.
      </p>
    </section>
  </main>
</BaseLayout>
