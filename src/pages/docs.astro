---
import BaseLayout from '../layouts/BaseLayout.astro';

const cli = 'https://github.com/agent-on-rails/agent-on-rails-cli';
const gettingStarted = `${cli}/blob/main/docs/getting-started.md`;
const controlPlane = 'https://github.com/agent-on-rails/agent-on-rails-control-plane';
const howToUse = `${controlPlane}/blob/main/guides/using-the-control-plane.md`;
const agentsMd = `${controlPlane}/blob/main/AGENTS.md`;
const specs = `${controlPlane}/tree/main/specs`;
---

<BaseLayout
  title="How to use Agent On Rails"
  description="Install the Agent On Rails CLI, write a spec, approve it, and hand a bounded task to a coding agent — with review and evidence before done."
>
  <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-5 md:px-8">
    <a href="/" class="inline-flex items-center gap-3" aria-label="Agent On Rails home">
      <img src="/brand/logo-mark.png?v=2b19b6f" alt="" width="36" height="36" class="h-9 w-9 object-contain" />
      <span class="font-display text-lg font-bold tracking-tight text-ink">
        Agent <span class="text-rail">On</span> Rails
      </span>
    </a>
    <a href="/" class="text-sm font-medium text-ink-mute hover:text-ink">Home</a>
  </header>

  <main class="mx-auto max-w-3xl px-6 pb-24 pt-8 md:px-8">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-rail-deep">Documentation</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink">
      How to use Agent On Rails
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-mute">
      Agent On Rails turns an approved spec into bounded work for coding agents —
      with review and evidence before anything is marked done.
      The <strong class="font-semibold text-ink">control plane</strong> is the contract folder
      inside your project, not the product name.
    </p>

    <section id="install" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ink">Install the CLI</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Requires Python 3.11+. Prefer
        <a class="font-semibold text-ink underline decoration-rail/60 underline-offset-4 hover:decoration-rail" href="https://pipx.pypa.io/">pipx</a>:
      </p>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code>pipx install git+https://github.com/agent-on-rails/agent-on-rails-cli.git
aor</code></pre>
      <p class="mt-3 text-ink-mute leading-relaxed">
        <code class="text-ink">aor</code> opens a mouse-friendly terminal UI (same idea as OpenCode, Claude Code, or Gemini).
        It is a harness — not a coding agent. Subcommands still work for scripts.
      </p>
      <p class="mt-3 text-sm text-ink-mute">
        Or:
        <code class="rounded bg-ink/5 px-1.5 py-0.5 text-ink">curl -fsSL https://raw.githubusercontent.com/agent-on-rails/agent-on-rails-cli/main/scripts/install.sh | bash</code>
      </p>
    </section>

    <section id="loop" class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ink">The loop</h2>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-ink px-4 py-4 text-sm leading-relaxed text-white/90"><code>aor init → aor spec new → aor spec approve → aor plan → aor run → aor review</code></pre>
      <ol class="mt-6 space-y-3 text-ink-mute">
        <li><span class="font-semibold text-ink">1. Init</span> — create the docs+specs contract. No application code.</li>
        <li><span class="font-semibold text-ink">2. Spec</span> — write <code class="text-ink">spec.md</code> + acceptance + evidence.</li>
        <li><span class="font-semibold text-ink">3. Approve</span> — a human must approve before agents run.</li>
        <li><span class="font-semibold text-ink">4. Plan / run</span> — Agent On Rails packages a bounded task for Cursor, Claude, Codex, or another headless agent.</li>
        <li><span class="font-semibold text-ink">5. Review</span> — humans own final review and merge. Evidence proves done.</li>
      </ol>
    </section>

    <div class="mt-12 space-y-6 border-t border-ink/10 pt-10">
      <a
        href={gettingStarted}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Full CLI walkthrough</h2>
        <p class="mt-2 text-ink-mute">
          Install, init, approve, plan, package a task, and record human final review.
        </p>
      </a>

      <a href={cli} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">CLI repository</h2>
        <p class="mt-2 text-ink-mute">Download and develop <code class="text-ink">aor</code> on GitHub.</p>
      </a>

      <a
        href={howToUse}
        class="block transition hover:text-rail-deep"
        target="_blank"
        rel="noreferrer"
      >
        <h2 class="font-display text-xl font-bold text-ink">Authority / contract guide</h2>
        <p class="mt-2 text-ink-mute">
          How specs, ADRs, policies, and evidence work inside the control-plane folder.
        </p>
      </a>

      <a href={agentsMd} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">AGENTS.md</h2>
        <p class="mt-2 text-ink-mute">
          Required first read for any coding agent — boundaries, review separation, and evidence rules.
        </p>
      </a>

      <a href={specs} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">Specs (AOR-001 … AOR-007)</h2>
        <p class="mt-2 text-ink-mute">
          MVP contracts for bootstrap, GitHub ingestion, planner, execution, review, escalation, and evidence.
        </p>
      </a>

      <a href={controlPlane} class="block transition hover:text-rail-deep" target="_blank" rel="noreferrer">
        <h2 class="font-display text-xl font-bold text-ink">Control plane repository</h2>
        <p class="mt-2 text-ink-mute">The authority tree — what should be built and how success is proven.</p>
      </a>
    </div>

    <section class="mt-14 rounded-2xl bg-gradient-to-br from-rail-wash via-white to-paper px-6 py-8">
      <h2 class="font-display text-2xl font-bold text-ink">Operating principle</h2>
      <p class="mt-3 text-ink-mute leading-relaxed">
        Docs define intent. Specs define the contract. Agent On Rails governs execution.
        Agents implement. Evidence proves completion. Humans own final review and merge.
      </p>
    </section>
  </main>
</BaseLayout>
